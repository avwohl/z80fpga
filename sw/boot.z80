; Boot monitor for the z80fpga SoC.
;
; Prints a banner, proves the banked memory works by writing a signature
; into every RAM bank and reading it back, then echoes the console.
;
; The bank check cannot run from ROM: selecting a RAM bank swaps the low
; 32 KB out from under the program counter.  So it is copied into the common
; bank at 8000h first and runs there, and it does its own port I/O rather
; than calling back into ROM.

UART_ST  equ 000h              ; bit 0 RX ready, bit 1 TX idle
UART_DAT equ 001h
BANK_RAM equ 078h
BANK_ROM equ 07Ch
LED      equ 0FFh              ; the LED port; boards show its low three bits
RAM_BASE equ 080h              ; RAM bank ids start here
RAM_N    equ 2                 ; must match the SoC's RAM_BANKS

; The monitor says the same things on the LED port that it says on the
; console, because a board can have a console that does not work and this one
; does: the Tang Nano's bridge died with JTAG still healthy, and for a while
; the only way to ask the machine anything was to build a separate image.
; Three bits is enough for the four states worth knowing from across a desk,
; and it costs four instructions:
;
;   1  alive, running from ROM
;   6  banked memory ok
;   7  a bank read back wrong
;   3  at the prompt, echoing - the system is up
;
; Lit is a 1 on every board here, and the leftmost of the three is the high
; bit.  A board with no LEDs writes the port and nothing happens.
;
; The verdict is written as F6h/F7h rather than 6/7.  The lamps show the low
; three bits either way, and the high nibble is what
; boards/tang_nano_20k/flashreport_top.sv watches for: it page-programs any
; F0h|n into the configuration flash, so on a board whose console has died
; the verdict still comes off over JTAG.  See that board's README.

         org 0000h

start:   di
         ld sp,0FFF0h
         ld a,1
         out (LED),a
         ld hl,banner
         call puts

         ; copy the bank checker into the common bank and run it there
         ld hl,bt_start
         ld de,08000h
         ld bc,bt_end-bt_start
         ldir
         call 08000h            ; returns the error count in A

         push af                ; say the verdict on the LEDs before the console,
         or a                   ; because the console is what may not be there
         ld a,0F6h              ; the high nibble is for boards that report
         jr z,ledv              ; through the flash; the lamps show the low
         ld a,0F7h              ; three bits either way
ledv:    out (LED),a
         pop af

         or a
         jr nz,bad
         ld hl,msg_ok
         call puts
         jr report
bad:     push af
         ld hl,msg_bad
         call puts
         pop af
         add a,'0'
         call putc
report:  ld hl,crlf
         call puts

         ld a,3                 ; up, and about to echo
         out (LED),a
         ld hl,prompt
         call puts
echo:    call getc
         cp 0Dh
         jr nz,echo1
         ld a,0Dh
         call putc
         ld a,0Ah
         call putc
         jr echo
echo1:   call putc
         jr echo

; ---------------------------------------------------------------- console
putc:    push af
putc1:   in a,(UART_ST)
         bit 1,a
         jr z,putc1
         pop af
         out (UART_DAT),a
         ret

getc:    in a,(UART_ST)
         bit 0,a
         jr z,getc
         in a,(UART_DAT)
         ret

puts:    ld a,(hl)
         or a
         ret z
         call putc
         inc hl
         jr puts

; ------------------------------------------------------- the bank checker
; Position independent: it runs from 8000h but is assembled here.  Only
; relative jumps, and the only absolute addresses it touches are 4000h and
; 4001h, which is the point - those live in whichever bank is selected.  The
; offset is deliberately clear of both the copied code and the stack, which
; land in the common bank at offsets 0000h and 7FF0h.
bt_start:
         ld c,RAM_BASE
         ld b,RAM_N
btw:     ld a,c
         out (BANK_RAM),a
         ld (4000h),a
         xor 0FFh
         ld (4001h),a
         inc c
         djnz btw

         ld c,RAM_BASE
         ld b,RAM_N
         ld d,0                 ; error count
btr:     ld a,c
         out (BANK_RAM),a
         ld a,(4000h)
         cp c
         jr z,btr1
         inc d
btr1:    ld a,(4001h)
         ld e,a
         ld a,c
         xor 0FFh
         cp e
         jr z,btr2
         inc d
btr2:    inc c
         djnz btr

         xor a                  ; back to ROM bank 0 before returning
         out (BANK_ROM),a
         ld a,d
         ret
bt_end:

; ------------------------------------------------------------------ text
banner:  db "z80fpga ready", 0Dh, 0Ah, 0
msg_ok:  db "banked memory ok", 0
msg_bad: db "banked memory errors: ", 0
crlf:    db 0Dh, 0Ah, 0
prompt:  db "> ", 0

         end
