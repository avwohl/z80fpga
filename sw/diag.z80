; Is the M1 refresh address what breaks the common bank?
;
; The core drives {I,R} on the address bus during T3-T4 of every M1, and the
; RAM's clock enable is tied high, so it latches that address and reads it
; every instruction.  With I = 0 the refresh address is 00xxh -- the LOW
; window.  While that holds ROM, a refresh read is harmless to code running
; in the common bank.  Once it holds RAM, the refresh read goes to the same
; RAM the fetch needs.
;
; So: set I to 80h, which puts the refresh address in the HIGH window
; alongside the code, and see whether the eight-byte cliff moves.
;
;   FAh   a marker at 800Bh is reached with I = 80h, where it was not with
;         I = 0 -- refresh is the mechanism
;   FFh   no change; refresh is not it

LED      equ 0FFh
BANK_RAM equ 078h
BANK_ROM equ 07Ch
RAM_BASE equ 080h

         org 0000h

start:   di
         ld sp,0FFF0h
         ld a,080h
         ld i,a                 ; refresh addresses become 80xxh
         ld hl,bt_start
         ld de,08000h
         ld bc,bt_end-bt_start
         ldir
         call 08000h
hang:    jr hang

bt_start:                       ; runs at 8000h
         ld a,RAM_BASE
         out (BANK_RAM),a
         nop
         nop
         nop
         nop
         ld a,0FAh
         out (LED),a
         xor a
         out (BANK_ROM),a
         ret
bt_end:
