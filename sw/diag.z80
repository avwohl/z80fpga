; Does a bank switch CORRUPT the common bank, or only break fetches from it?
;
; Execution past about 8008h fails while a RAM bank is selected.  This puts
; ROM back inside that safe window -- five instructions, all below 8008h --
; and only then reads 8040h, where A5h was planted before the copy.  So the
; read runs with ROM in the low window, where everything is known to work.
;
;   F5h   8040h still holds A5h: the switch does not damage the common bank,
;         it only breaks fetches from it while a RAM bank is selected
;   Fxh   it holds something else, and x is the low nibble -- the switch
;         wrote over the common bank, which is a write going somewhere it
;         should not, and that is fixable

LED      equ 0FFh
BANK_RAM equ 078h
BANK_ROM equ 07Ch
RAM_BASE equ 080h

         org 0000h

start:   di
         ld sp,0FFF0h
         ld hl,bt_start
         ld de,08000h
         ld bc,bt_end-bt_start
         ldir
         call 08000h
hang:    jr hang

bt_start:                       ; runs at 8000h
         ld a,RAM_BASE          ; 0
         out (BANK_RAM),a       ; 2   RAM bank 0 in
         xor a                  ; 4
         out (BANK_ROM),a       ; 5   ROM back, still inside the safe window
         ld a,(08040h)          ; 7   now read the common bank
         and 00Fh               ; 10
         or 0F0h                ; 12
         out (LED),a            ; 14
         ret                    ; 16
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 0A5h
bt_end:
