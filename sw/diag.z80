; Does LDIR into the common bank work in this build, and does code there run?
;
; The instrument is now proved: three markers from a ROM-only program all
; come back.  And a bare probe at 8000h -- no banking anywhere in it -- does
; not.  So either the copy does not land or the code there does not run.
; This asks, entirely from ROM, which has never failed.
;
;   F5, F1  8000h and 8001h read back 3Eh and F1h: the copy landed, so it is
;           execution in the common bank that fails
;   other   the copy did not land

LED      equ 0FFh

         org 0000h

start:   di
         ld sp,0FFF0h

         ld hl,pa_s
         ld de,08000h
         ld bc,pa_e-pa_s
         ldir

         ld a,(08000h)          ; want 3Eh -> nibble E
         and 00Fh
         or 0F0h
         out (LED),a
         call bigdel

         ld a,(08001h)          ; want F1h -> nibble 1
         and 00Fh
         or 0F0h
         out (LED),a
         call bigdel

         ld a,(08004h)          ; want C9h -> nibble 9
         and 00Fh
         or 0F0h
         out (LED),a
hang:    jr hang

bigdel:  ld b,20
bd1:     push bc
         ld de,0
bd2:     dec de
         ld a,d
         or e
         jr nz,bd2
         pop bc
         djnz bd1
         ret

pa_s:    ld a,0F1h              ; 3E F1
         out (LED),a            ; D3 FF
         ret                    ; C9
pa_e:
