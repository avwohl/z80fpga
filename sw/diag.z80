; Clean baseline, fresh flash region, nothing carried over.
;
; F1 and F2 come from ROM, before anything else, so they prove the channel
; is alive in this very run -- a silence after them means something, and a
; silence instead of them means the instrument.
;
;   F1  running, from ROM
;   F2  still running, from ROM
;   F3  a bare probe in the common bank ran      (no banking in it at all)
;   F4  that probe returned
;   F5  a probe that does a bank switch reached its next instruction
;   F6  that probe returned

LED      equ 0FFh
BANK_RAM equ 078h
BANK_ROM equ 07Ch
RAM_BASE equ 080h

         org 0000h

start:   di
         ld sp,0FFF0h
         ld a,0F1h
         out (LED),a
         call bigdel
         ld a,0F2h
         out (LED),a
         call bigdel

         ld hl,pa_s             ; probe A: no banking anywhere in it
         ld de,08000h
         ld bc,pa_e-pa_s
         ldir
         call 08000h            ; emits F3
         ld a,0F4h
         out (LED),a
         call bigdel

         ld hl,pb_s             ; probe B: with a bank switch
         ld de,08000h
         ld bc,pb_e-pb_s
         ldir
         call 08000h            ; emits F5
         ld a,0F6h
         out (LED),a
hang:    jr hang

bigdel:  ld b,20
bd1:     push bc
         ld de,0
bd2:     dec de
         ld a,d
         or e
         jr nz,bd2
         pop bc
         djnz bd1
         ret

pa_s:    ld a,0F3h
         out (LED),a
         ret
pa_e:

pb_s:    ld a,RAM_BASE
         out (BANK_RAM),a
         ld a,0F5h
         out (LED),a
         xor a
         out (BANK_ROM),a
         ret
pb_e:
