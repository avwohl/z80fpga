; How far into sw/boot.z80's checker does it get, marked with I/O only?
;
; Memory writes are the thing under suspicion, so every marker here is
; `out (0FFh),a` -- an I/O write that touches no memory.  The board top turns
; the first F0h|n on that port into a flash page program, once, latched, so
; exactly one marker escapes and it is the furthest one reached.
;
; Established with this channel already: the bank-select OUT survives, and so
; does a high-window write taken straight after it.  So this runs the whole
; write loop, which is where the marker-in-memory version said it died.
;
;   F7h   fetching from the high window while a RAM bank is selected is
;         fine, so it really is the second write to the bank port
;   FFh   plain instruction fetch from the high window fails once a RAM
;         bank is selected, and the bank port has nothing to do with it

LED      equ 0FFh
BANK_RAM equ 078h
BANK_ROM equ 07Ch
RAM_BASE equ 080h
RAM_N    equ 2

         org 0000h

start:   di
         ld sp,0FFF0h
         ld hl,bt_start
         ld de,08000h
         ld bc,bt_end-bt_start
         ldir
         call 08000h
hang:    jr hang

bt_start:
         ld a,RAM_BASE
         out (BANK_RAM),a       ; RAM bank 0 into the low window
         nop                    ; and then just fetch, from the high window,
         nop                    ; which the switch does not move
         nop
         nop
         nop
         nop
         nop
         nop
         ld a,0F7h
         out (LED),a            ; I/O only

         xor a
         out (BANK_ROM),a
         ret
bt_end:
