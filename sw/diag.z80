; Once a RAM bank is selected, does the common bank still READ correctly?
;
; Two instructions after a bank switch reach their marker; eight NOPs, or a
; jump to 8040h, do not.  So the address matters.  ramtest cleared the
; address lines -- but it ran with ROM in the low window, which is not the
; case here.
;
; This keeps every instruction low, where execution is known to survive, and
; reads one byte from 8040h.  A5h is planted there, so the marker says what
; came back:
;
;   F5h   8040h read back A5h -- the data is fine, so it is the FETCH that
;         fails higher up, not the memory
;   Fxh   it read something else, and x is the low nibble of what
;   FFh   it did not even get that far

LED      equ 0FFh
BANK_RAM equ 078h
BANK_ROM equ 07Ch
RAM_BASE equ 080h

         org 0000h

start:   di
         ld sp,0FFF0h
         ld hl,bt_start
         ld de,08000h
         ld bc,bt_end-bt_start
         ldir
         call 08000h
hang:    jr hang

bt_start:                       ; runs at 8000h
         ld a,RAM_BASE
         out (BANK_RAM),a       ; RAM bank 0 into the low window
         ld a,(08040h)          ; read the common bank, high up
         and 00Fh
         or 0F0h
         out (LED),a            ; say what came back
         xor a
         out (BANK_ROM),a
         ret
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 000h
         db 0A5h
bt_end:
