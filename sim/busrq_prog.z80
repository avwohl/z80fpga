; The program sim/tb_busrq.sv runs on two cores at once: one that never gives
; the bus away and one that does so at random.  Their memory, their port
; writes and their registers must come out the same.  The program uses every
; kind of M-cycle: opcode fetches, memory reads and writes with and without
; extra T-states, I/O reads and writes, block moves, the DD CB forms, and a
; HALT at the end, where the bus requests go on during the NOP fetches.

DST      equ 09000h

         org 0000h

start:   ld sp,0F000h
         ld hl,src
         ld de,DST
         ld bc,16
         ldir                    ; 21 T-states per byte, MR + MW
         ld b,12
loop:    push bc
         call sub
         pop bc
         ex (sp),hl              ; MR, MR+1, MW, MW+2
         ex (sp),hl
         in a,(12h)              ; I/O read
         out (34h),a             ; I/O write
         ld hl,DST
         inc (hl)                ; MR+1, MW
         ld ix,DST
         inc (ix+3)
         set 1,(ix+4)            ; DD CB d op
         rlc (ix+5)
         ld a,(ix+6)
         add a,(hl)
         ld (DST+100h),a
         ld hl,(DST+2)
         ld (DST+102h),hl
         ld c,56h
         in e,(c)
         out (c),e
         djnz loop
         ld a,55h
         ld (DST+200h),a
         jr done

sub:     ld a,(de)
         cpl
         ld (de),a
         inc de
         ret

done:    halt

src:     db 01h,02h,03h,04h,05h,06h,07h,08h
         db 11h,22h,33h,44h,55h,66h,77h,88h
