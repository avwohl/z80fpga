; Drive the SIMH HDSK controller from a real Z80, the way RomWBW's hdsk.asm
; does: a seven-byte parameter block shifted out with OTIR, then one IN for
; status.  Write a sector, read it back somewhere else, compare.
;
; The point of doing it from the core rather than from a testbench is that this
; puts the pieces the module-level test cannot reach into the loop -- the MMU
; translating the DMA address, the memory behind it, and OTIR itself, which
; leaves B on the high half of the address bus while it runs.
;
; Prints:  W<status> R<status> <first four bytes read back> OK   or  BAD
;
; The buffers sit above 8000h so they are in the common bank, which is where
; HBIOS puts its disk buffer too.

UART_ST  equ 000h              ; bit 0 RX ready, bit 1 TX idle
UART_DAT equ 001h
HDSK     equ 0FDh

SRC      equ 09000h            ; what we send
DST      equ 0A000h            ; where it comes back
FLU      equ 0B000h            ; somewhere to put the flushing read
BLK      equ 0B800h            ; the command blocks, copied into RAM
; The status bytes have to live in RAM.  As `db` in the source they sat in the
; ROM image, so `ld (ST1),a` went nowhere and `ld a,(ST1)` read the ROM's zero
; back -- which prints as a perfectly plausible "status 00" no matter what the
; controller actually said.
ST1      equ 0B900h
ST2      equ 0B901h
ST3      equ 0B902h
ST4      equ 0B903h

         org 0000h

start:   di
         ld sp,0FFF0h

         ; Run the whole test over and over.  The board prints once and halts
         ; otherwise, and the console cannot be opened until the programmer has
         ; let go of the cable -- by which time the one line is long gone.
again:
         ; A banner before anything touches the card.  Silence on the console
         ; is otherwise ambiguous: it could be a hung disk command or a CPU
         ; that never started, and those want opposite investigations.
         ld hl,hello
         call puts

         ; fill SRC with a recognisable 512-byte pattern
         ld hl,SRC
         ld a,0A5h
         ld bc,512
fill:    ld (hl),a
         inc hl
         inc a
         dec bc
         ld d,a
         ld a,b
         or c
         ld a,d
         jr nz,fill

         ; wipe DST so a read that does nothing is obvious
         ld hl,DST
         ld bc,512
         xor a
wipe:    ld (hl),a
         inc hl
         dec bc
         ld d,a
         ld a,b
         or c
         ld a,d
         jr nz,wipe

         ; ---- copy the command blocks into RAM before using them.  In ROM
         ;      they are read without a wait state; in RAM every read of one
         ;      can stall the core on the memory, which is the condition
         ;      RomWBW's driver runs under and this test never did.
         ld hl,wcmd
         ld de,BLK
         ld bc,21
cpblk:   ld a,(hl)
         ld (de),a
         inc hl
         inc de
         dec bc
         ld a,b
         or c
         jr nz,cpblk

         ; ---- the three commands back to back, with nothing between them
         ;      but the store of the status.  Printing between them, which is
         ;      what this used to do, leaves hundreds of T-states of console
         ;      polling in the gap; RomWBW's driver has four instructions
         ;      there, and that is the shape that fails on hardware.
         ld hl,BLK
         ld b,7
         ld c,HDSK
         otir
         in a,(HDSK)
         ld (ST1),a

         ld hl,BLK+7
         ld b,7
         ld c,HDSK
         otir
         in a,(HDSK)
         ld (ST2),a

         ld hl,BLK+14
         ld b,7
         ld c,HDSK
         otir
         in a,(HDSK)
         ld (ST3),a

         ; One more read with nothing outstanding.  It has to come back 8E.
         ; If it comes back as the previous command's status instead, the
         ; controller's wait is arriving too late to stall the cycle it belongs
         ; to and every status read is answering the read before it -- which is
         ; invisible whenever the statuses happen to be equal, so check it here
         ; where they are not.
         in a,(HDSK)
         ld (ST4),a

         ld a,'W'
         call putc
         ld a,(ST1)
         call puthex
         ld a,'F'
         call putc
         ld a,(ST2)
         call puthex
         ld a,'R'
         call putc
         ld a,(ST3)
         call puthex
         ld a,'S'
         call putc
         ld a,(ST4)
         call puthex

         ; ---- show the first four bytes that came back
         ld a,' '
         call putc
         ld hl,DST
         ld b,4
show:    ld a,(hl)
         push bc
         push hl
         call puthex
         pop hl
         pop bc
         inc hl
         djnz show

         ; ---- compare all 512
         ld hl,SRC
         ld de,DST
         ld bc,512
cmp1:    ld a,(de)
         cp (hl)
         jr nz,bad
         inc hl
         inc de
         dec bc
         ld a,b
         or c
         jr nz,cmp1

         ld hl,okmsg
         call puts
         call delay
         jp again

bad:     ld hl,badmsg
         call puts
         call delay
         jp again

; about a second at 8.33 MHz, so the console shows a readable trickle
delay:   ld de,2000
dly1:    ld b,0
dly2:    djnz dly2
         dec de
         ld a,d
         or e
         jr nz,dly1
         ret

; ------------------------------------------------------------------ console
putc:    push af
putc1:   in a,(UART_ST)
         bit 1,a
         jr z,putc1
         pop af
         out (UART_DAT),a
         ret

puts:    ld a,(hl)
         or a
         ret z
         call putc
         inc hl
         jr puts

puthex:  push af
         rrca
         rrca
         rrca
         rrca
         call puthex1
         pop af
puthex1: and 0Fh
         add a,090h
         daa
         adc a,040h
         daa
         jp putc

; ------------------------------------------------------------ command blocks
; cmd, drive, sector, track lo, track hi, dma lo, dma hi
; DMA address is little endian: low byte then high.  Spelled out because the
; assembler has no low/high operators.
; A deliberately non-zero LBA: sector 12h, track 0034h, so LBA = 003412h.
; CP/M's directory is nowhere near sector 0, and an LBA assembled wrongly in
; its high bytes would read correctly from 0 and write somewhere else.
wcmd:    db 3, 0, 012h, 034h, 000h, 000h, 090h
fcmd:    db 2, 0, 099h, 034h, 000h, 000h, 0B0h
rcmd:    db 2, 0, 012h, 034h, 000h, 000h, 0A0h

hello:   db "HDSK", 0Dh, 0Ah, 0
okmsg:   db " OK", 0Dh, 0Ah, 0
badmsg:  db " BAD", 0Dh, 0Ah, 0
